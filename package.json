{
  "name": "agent-ops-kit",
  "version": "0.1.0",
  "description": "Tool-centered harness for agent-friendly software repositories.",
  "type": "module",
  "bin": {
    "agent-ops": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm build:web",
    "build:web": "vite build",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm typecheck && pnpm deadcode",
    "deadcode": "knip",
    "web": "pnpm build:web && tsx scripts/web-launch.ts",
    "dev:web": "vite --host 127.0.0.1",
    "discord": "tsx src/surfaces/chat/discord/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests scripts drizzle.config.ts",
    "retire-legacy-state": "tsx scripts/retire-legacy-state.ts",
    "sweep": "tsx src/cli.ts sweep",
    "test": "vitest run",
    "test:web": "pnpm build:web && playwright test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.3",
    "@earendil-works/pi-ai": "^0.84.3",
    "@hono/node-server": "^2.1.1",
    "@tanstack/react-router": "^1.170.34",
    "@tanstack/react-start": "^1.168.51",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "lucide-react": "^1.43.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.39.1",
    "knip": "^5.71.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.3.0",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1"
}
