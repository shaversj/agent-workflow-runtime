{
  "name": "agent-ops-kit",
  "version": "0.1.0",
  "description": "Tool-centered harness for agent-friendly software repositories.",
  "type": "module",
  "bin": {
    "agent-ops": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm typecheck",
    "deadcode": "knip",
    "discord": "tsx src/surfaces/chat/discord/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests drizzle.config.ts",
    "sweep": "tsx src/cli.ts sweep",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.2",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.39.1",
    "knip": "^5.71.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1"
}
