# Copy this file to $AGENT_OPS_HOME/.env (default: ~/.agent-ops-kit/.env), or set
# AGENT_OPS_ENV_FILE to an absolute operator-owned path before starting Agent Workflow Runtime.
# Runtime configuration is never loaded from the process working directory.

# Read-only workflows retain their existing configuration.
MINIMAX_API_KEY=
LOG_LEVEL=warn
LOG_FORMAT=json

# Discord refuses to start without an immutable user allowlist and at least one guild or
# channel restriction. Direct messages are not supported.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
# Only these already-allowed users may use a local DISCORD_DEFAULT_REPO_PATH.
DISCORD_LOCAL_REPO_USER_IDS=
DISCORD_DEFAULT_MODEL=
DISCORD_DEFAULT_REPO_PATH=
DISCORD_TIMEOUT_MS=120000
DISCORD_SHUTDOWN_GRACE_MS=10000
DISCORD_ENABLED_PLUGIN_SOURCES=readiness,github
DISCORD_ALLOW_DMS=false

# Coding and publication are independently disabled by default.
CODING_ENABLED=false
CODING_PUBLICATION_ENABLED=false
# Obtain CLI principal with: echo "cli:$(id -u)"; Discord uses discord:<user-id>.
CODING_ALLOWED_PRINCIPALS=[]
# Trusted operator configuration only. Replace the digest and principal before enabling.
# CODING_PROFILES={"owner/repo":{"image":"node@sha256:<64-hex-digest>","requiredChecks":["node --test"],"ignore":[],"principal":"cli:501"}}
CODING_PROFILES={}
CODING_MODEL=MiniMax-M3
CODING_TIMEOUT_MS=1200000
CODING_MAX_MODEL_CALLS=30
CODING_MAX_TOKENS=100000
CODING_PROPOSAL_RETENTION_MS=86400000
# Distinct, scoped credentials. Never inherit GITHUB_TOKEN/GH_TOKEN for coding writes.
CODING_GITHUB_READ_TOKEN=
CODING_GITHUB_WRITE_TOKEN=
