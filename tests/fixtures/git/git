#!/usr/bin/env node
const fs = require("node:fs");
const path = require("node:path");
const { spawn } = require("node:child_process");

const modePath = path.join(process.cwd(), ".fake-git-mode");
const mode = fs.existsSync(modePath) ? fs.readFileSync(modePath, "utf8").trim() : "root";

if (mode === "flood-stdout") {
  process.stdout.write("x".repeat(1024 * 1024));
  setInterval(() => undefined, 1000);
} else if (mode === "flood-stderr") {
  process.stderr.write("x".repeat(1024 * 1024));
  setInterval(() => undefined, 1000);
} else if (mode === "ignore-term") {
  process.on("SIGTERM", () => undefined);
  const child = spawn(process.execPath, ["-e", "setInterval(() => undefined, 1000)"], {
    stdio: "ignore"
  });
  fs.writeFileSync(path.join(process.cwd(), ".fake-git-child"), String(child.pid));
  setInterval(() => undefined, 1000);
} else if (mode === "capture-env") {
  fs.writeFileSync(
    path.join(process.cwd(), ".fake-git-env"),
    JSON.stringify({
      HOME: process.env.HOME,
      GIT_CONFIG_NOSYSTEM: process.env.GIT_CONFIG_NOSYSTEM,
      GIT_CONFIG_GLOBAL: process.env.GIT_CONFIG_GLOBAL,
      GIT_TERMINAL_PROMPT: process.env.GIT_TERMINAL_PROMPT,
      GIT_ASKPASS: process.env.GIT_ASKPASS,
      hostile: process.env.HOSTILE_GIT_VALUE
    })
  );
  process.stdout.write(process.cwd());
} else if (mode === "stall") {
  setInterval(() => undefined, 1000);
} else {
  process.stdout.write(process.cwd());
}
